# Tavily real-time news / policy search
TAVILY_API_KEY=

# Serper / Google Images（可选：用于真实网络配图；全部代码绘图无需配置）
SERPER_API_KEY=

# DeepSeek V4 Flash (OpenAI-compatible Chat Completions API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com


# Server
HOST=127.0.0.1
PORT=8787
APP_ENV=development

# Optional local visual fonts (do not copy font binaries into the project)
# DEG_VISUAL_FONT=/path/to/CJK-Regular.ttf
# DEG_VISUAL_FONT_BOLD=/path/to/CJK-Bold.ttf
# DEG_VISUAL_FONT_SERIF=/path/to/CJK-Serif.ttf
